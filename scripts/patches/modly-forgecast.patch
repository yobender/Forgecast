+@router.post("/from-images")
+async def generate_from_images(
+    background_tasks: BackgroundTasks,
+    front: UploadFile | None = File(None),
+    left: UploadFile | None = File(None),
+    back: UploadFile | None = File(None),
+    right: UploadFile | None = File(None),
+    top: UploadFile | None = File(None),
+    bottom: UploadFile | None = File(None),
+    model_id: str = Form("hunyuan3d-mini/multiview"),
+    collection: str = Form("Default"),
+    remesh: str = Form("none"),
+    enable_texture: bool = Form(False),
+    texture_resolution: int = Form(1024),
+    params: str = Form("{}"),
+):
+    uploads = {
+        "front": front,
+        "left": left,
+        "back": back,
+        "right": right,
+        "top": top,
+        "bottom": bottom,
+    }
+    supplied = {view: upload for view, upload in uploads.items() if upload is not None}
+    if not supplied:
+        raise HTTPException(400, "At least one reference image is required")
+    if not any(view in supplied for view in ("front", "left", "back", "right")):
+        raise HTTPException(400, "Shape generation requires a front, left, back, or right image")
+    for view, upload in supplied.items():
+        if not upload.content_type or not upload.content_type.startswith("image/"):
+            raise HTTPException(400, f"{view} reference must be an image")
+
+    if remesh not in ("quad", "triangle", "none"):
+        raise HTTPException(400, "remesh must be 'quad', 'triangle', or 'none'")
+    collection = collection.strip()
+    if not collection or _re.search(r'[/:*?"<>|\\]', collection):
+        collection = "Default"
+
+    try:
+        generator_registry.get_generator(model_id)
+    except ValueError as exc:
+        raise HTTPException(400, str(exc))
+    generator_registry.switch_model(model_id)
+
+    try:
+        model_params = json.loads(params)
+    except (json.JSONDecodeError, TypeError):
+        model_params = {}
+
+    image_set = {view: await upload.read() for view, upload in supplied.items()}
+    full_params = {
+        "remesh": remesh,
+        "enable_texture": enable_texture,
+        "texture_resolution": texture_resolution,
+        **model_params,
+    }
+
+    _purge_old_jobs()
+    job_id = str(uuid.uuid4())
+    job = JobStatus(job_id=job_id, status="pending", progress=0)
+    _jobs[job_id] = job
+    _cancel_events[job_id] = threading.Event()
+    background_tasks.add_task(_run_generation, job_id, image_set, full_params, collection)
+    return {"job_id": job_id}
+
+
 
 @router.get("/status/{job_id}")
 async def job_status(job_id: str):
