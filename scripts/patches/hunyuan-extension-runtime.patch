+    def _apply_multiview_colors(self, mesh, views: dict[str, Image.Image]):
+        if len(views) == 1 and "front" in views:
+            return self._apply_reference_colors(mesh, views["front"])
+
+        try:
+            import numpy as np
+
+            vertices = np.asarray(mesh.vertices)
+            normals = np.asarray(mesh.vertex_normals)
+            if vertices.ndim != 2 or len(vertices) == 0:
+                return mesh
+
+            view_directions = {
+                "front": np.array([0.0, 0.0, 1.0]),
+                "back": np.array([0.0, 0.0, -1.0]),
+                "left": np.array([-1.0, 0.0, 0.0]),
+                "right": np.array([1.0, 0.0, 0.0]),
+                "top": np.array([0.0, 1.0, 0.0]),
+                "bottom": np.array([0.0, -1.0, 0.0]),
+            }
+            available = [view for view in view_directions if view in views]
+            direction_matrix = np.stack([view_directions[view] for view in available])
+            selected = np.argmax(normals @ direction_matrix.T, axis=1)
+
+            mins = vertices.min(axis=0)
+            spans = np.maximum(np.ptp(vertices, axis=0), 1e-8)
+            normalized = np.clip((vertices - mins) / spans, 0.0, 1.0)
+            result = np.zeros((len(vertices), 4), dtype=np.uint8)
+            result[:, 3] = 255
+
+            for view_index, view in enumerate(available):
+                vertex_indexes = np.flatnonzero(selected == view_index)
+                if len(vertex_indexes) == 0:
+                    continue
+                xyz = normalized[vertex_indexes]
+                if view == "front":
+                    u, v = xyz[:, 0], xyz[:, 1]
+                elif view == "back":
+                    u, v = 1.0 - xyz[:, 0], xyz[:, 1]
+                elif view == "left":
+                    u, v = xyz[:, 2], xyz[:, 1]
+                elif view == "right":
+                    u, v = 1.0 - xyz[:, 2], xyz[:, 1]
+                elif view == "top":
+                    u, v = xyz[:, 0], 1.0 - xyz[:, 2]
+                else:  # bottom
+                    u, v = xyz[:, 0], xyz[:, 2]
+                result[vertex_indexes] = self._sample_reference(views[view], u, v)
+
+            mesh.visual.vertex_colors = result
+            return mesh
+        except Exception as exc:
+            print(f"[Hunyuan3DMiniGenerator] Multi-view color bake skipped: {exc}")
+            primary = views.get("front") or next(iter(views.values()))
+            return self._apply_reference_colors(mesh, primary)
