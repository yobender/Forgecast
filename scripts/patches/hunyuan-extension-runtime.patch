+    def _apply_reference_colors(self, mesh, image: Image.Image):
+        """Project reference-image color onto the mesh as embedded vertex colors.
+
+        Hunyuan3D Mini generates shape only. Vertex colors give Forgecast a
+        compact, texture-file-free color result that survives GLB export and is
+        understood by Three.js, Blender, Unity, Godot, and Unreal.
+        """
+        try:
+            import numpy as np
+
+            vertices = np.asarray(mesh.vertices)
+            if vertices.ndim != 2 or len(vertices) == 0:
+                return mesh
+
+            rgba = np.asarray(image.convert("RGBA"))
+            foreground = rgba[:, :, 3] > 16
+            if not foreground.any():
+                return mesh
+
+            image_y, image_x = np.nonzero(foreground)
+            left, right = int(image_x.min()), int(image_x.max())
+            top, bottom = int(image_y.min()), int(image_y.max())
+
+            x_min, y_min = vertices[:, 0].min(), vertices[:, 1].min()
+            x_span = max(float(np.ptp(vertices[:, 0])), 1e-8)
+            y_span = max(float(np.ptp(vertices[:, 1])), 1e-8)
+            u = np.clip((vertices[:, 0] - x_min) / x_span, 0.0, 1.0)
+            v = np.clip((vertices[:, 1] - y_min) / y_span, 0.0, 1.0)
+
+            px = np.rint(left + u * max(right - left, 1)).astype(np.int32)
+            py = np.rint(bottom - v * max(bottom - top, 1)).astype(np.int32)
+            sampled = rgba[py, px].copy()
+
+            # Silhouette differences can land a few vertices in transparent
+            # pixels. Fill those with the foreground median instead of black.
+            fallback = np.median(rgba[foreground, :3], axis=0).astype(np.uint8)
+            transparent = sampled[:, 3] <= 16
+            sampled[transparent, :3] = fallback
+            sampled[:, 3] = 255
+
+            mesh.visual.vertex_colors = sampled
+            return mesh
+        except Exception as exc:
+            print(f"[Hunyuan3DMiniGenerator] Reference color bake skipped: {exc}")
